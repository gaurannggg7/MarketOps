# Copy to .env (`make env` generates one with random demo passwords). Never commit .env.
POSTGRES_USER=marketops
POSTGRES_PASSWORD=marketops-local-only
POSTGRES_DB=marketops
POSTGRES_PORT=55432

MARKETOPS_ENVIRONMENT=development
MARKETOPS_DATABASE_URL=postgresql+psycopg://marketops:marketops-local-only@localhost:55432/marketops
# JSON list of browser origins allowed for cookie writes and WebSocket handshakes.
MARKETOPS_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:8080"]
# Plain-HTTP cookies are permitted only for local development (ADR 0003). Set true behind HTTPS.
MARKETOPS_COOKIE_SECURE=false
MARKETOPS_SIMULATOR_SEED=20261013

# Demo users created by `make seed`. Leave blank to have the seed command generate passwords.
DEMO_OPERATOR_PASSWORD=
DEMO_OPERATOR2_PASSWORD=
DEMO_VIEWER_PASSWORD=
