# Copy to deploy/.env.production ON THE SERVER ONLY (gitignored; chmod 600).
# Generate secrets with: python3 -c "import secrets; print(secrets.token_urlsafe(24))"
MARKETOPS_VERSION=1.1.0
MARKETOPS_DOMAIN=marketops.example.com
ACME_EMAIL=you@example.com

POSTGRES_USER=marketops
POSTGRES_PASSWORD=
POSTGRES_DB=marketops

# Private operator accounts (never shared publicly). The viewer password is only needed for a
# private viewer login; public visitors use the passwordless read-only demo entry.
DEMO_OPERATOR_PASSWORD=
DEMO_OPERATOR2_PASSWORD=
DEMO_VIEWER_PASSWORD=

MARKETOPS_PUBLIC_DEMO_ENABLED=true
MARKETOPS_DEMO_AUTOPILOT_ENABLED=true
MARKETOPS_DEMO_AUTOPILOT_INTERVAL_SECONDS=300
MARKETOPS_QUOTE_RETENTION_HOURS=3
